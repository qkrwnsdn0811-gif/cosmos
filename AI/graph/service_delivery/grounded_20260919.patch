diff --git a/BackEnd/ANALYSIS_RUN_API.md b/BackEnd/ANALYSIS_RUN_API.md
new file mode 100644
--- /dev/null
+++ b/BackEnd/ANALYSIS_RUN_API.md
@@ -0,0 +1,47 @@
+# Versioned analysis read contract
+
+All news, graph, evidence, and company metric reads use the selected
+`cosmos_analysis.current_*` views or explicit active-run keyed joins.
+The news feed first selects eligible page IDs and then reads article summaries;
+unfiltered cursor pages use the run/sort index instead of scanning every article.
+The publisher owns the active-run switch.
+Live collection, user accounts, scraps, and watchlists remain in `public`.
+Existing scrap lists keep their public article metadata and original links;
+new scrap registration requires an article visible in the selected run.
+An old scrap does not grant access to analysis excluded from the active run.
+
+## Additional response fields
+
+- `GET /api/analysis-runs/active` is public and returns `runId`,
+  `snapshotId`, `asOf`, `counts`, and `displayName`.
+- News list/detail preserve nullable `publishedAt` and expose
+  `sourceRevisionId`, `publishedAtRaw`, and `publicationPrecision`.
+  Pagination uses a separate internal `sort_at`, never a fabricated
+  publication timestamp. Date-range filters match verified publication times.
+- Relationship detail includes `explanation: string | null` and
+  `explanationScope: "HISTORICAL" | null`. This stored, cited explanation
+  describes the relationship's history, separately from the selected score window.
+- Relationship evidence accepts `window=7D|30D|90D` (default `30D`).
+  The source availability interval is `[asOf-window, asOf)`.
+  Both news and disclosures are returned. Each quote has `evidenceId`,
+  `documentId`, `sourceType`, `sourceRevisionId`,
+  `publishedAtRaw`, and `publicationPrecision`.
+  The legacy `newsId` field remains an alias for document ID.
+  Distinct quotes from one document are retained and paginate by
+  `(sort_at, evidenceId)`.
+- `nextRefreshAt` is null for this static publication; no automatic refresh
+  is claimed.
+- Unknown company metric counts and sentiment/impact/confidence values remain
+  null. They are not zero, neutral, or a GNN prediction.
+
+Frontend caches must be invalidated together when the selected `runId` changes.
+The default graph still selects the 30D window. Historical relation storage
+counts and the active graph's window edge count are different quantities.
+
+## Validation
+
+The integration fixtures explicitly capture a selected run rather than relying
+on public rows to leak into the analysis views. Coverage includes unknown
+publication time and pagination, live-collector isolation, nullable metric
+counts, disclosure quotes, same-document multiple quotes, and exact UTC window
+boundaries. Integration tests require an isolated PostgreSQL/Redis environment.
diff --git a/BackEnd/src/main/java/com/cosmos/api/analysis/AnalysisRunController.java b/BackEnd/src/main/java/com/cosmos/api/analysis/AnalysisRunController.java
new file mode 100644
--- /dev/null
+++ b/BackEnd/src/main/java/com/cosmos/api/analysis/AnalysisRunController.java
@@ -0,0 +1,48 @@
+package com.cosmos.api.analysis;
+
+import com.cosmos.api.global.error.BusinessException;
+import com.cosmos.api.graph.error.GraphErrorCode;
+import java.time.Instant;
+import java.util.Map;
+import java.util.UUID;
+import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
+import org.springframework.transaction.annotation.Isolation;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RestController;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+/** Read-only publication metadata; selecting or changing a run is a loader operation. */
+@RestController
+public class AnalysisRunController {
+    private final NamedParameterJdbcTemplate jdbc;
+    private final ObjectMapper mapper;
+
+    public AnalysisRunController(NamedParameterJdbcTemplate jdbc, ObjectMapper mapper) {
+        this.jdbc = jdbc;
+        this.mapper = mapper;
+    }
+
+    @GetMapping("/api/analysis-runs/active")
+    @Transactional(readOnly = true, isolation = Isolation.REPEATABLE_READ)
+    public ActiveAnalysisRun active() {
+        return jdbc.query("""
+                SELECT r.run_id, r.snapshot_id, r.as_of_at, r.counts::text AS counts,
+                       COALESCE(NULLIF(r.metadata ->> 'display_name', ''),
+                                '검증된 뉴스·공시 분석') AS display_name
+                FROM cosmos_analysis.runs r
+                JOIN cosmos_analysis.active_run a ON a.run_id = r.run_id
+                WHERE a.singleton = TRUE
+                """, Map.of(), (rs, rowNum) -> new ActiveAnalysisRun(
+                        rs.getString("run_id"), rs.getObject("snapshot_id", UUID.class),
+                        rs.getTimestamp("as_of_at").toInstant(), mapper.readTree(rs.getString("counts")),
+                        rs.getString("display_name")))
+                .stream().findFirst()
+                .orElseThrow(() -> new BusinessException(GraphErrorCode.GRAPH_SNAPSHOT_NOT_FOUND));
+    }
+
+    public record ActiveAnalysisRun(
+            String runId, UUID snapshotId, Instant asOf, JsonNode counts, String displayName
+    ) {}
+}
