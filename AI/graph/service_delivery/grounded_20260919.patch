+import type { QueryClient } from "@tanstack/react-query";
+
+const ANALYSIS_QUERY_ROOTS = new Set(["news", "graph", "relationship", "company", "companies", "industries"]);
+export const isAnalysisQuery = (query: { queryKey: readonly unknown[] }) => ANALYSIS_QUERY_ROOTS.has(String(query.queryKey[0]));
+
+export async function resetAnalysisQueries(client: QueryClient) {
+  await client.cancelQueries({ predicate: isAnalysisQuery });
+  await client.resetQueries({ predicate: isAnalysisQuery });
+}
