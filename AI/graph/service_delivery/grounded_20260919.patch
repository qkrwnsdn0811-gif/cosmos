@@ -0,0 +1,43 @@
+package com.cosmos.api.support;
+
+import org.springframework.jdbc.core.JdbcTemplate;
+
+/** Isolated test transactions capture their public fixtures as a selected immutable version. */
+public final class AnalysisRunFixture {
+    public static final String RUN_ID = "integration-test-run";
+    private AnalysisRunFixture() {}
+
+    public static void capture(JdbcTemplate jdbc) {
+        jdbc.update("""
+                INSERT INTO cosmos_analysis.runs(run_id, as_of_at, publication_sha256, status)
+                VALUES (?, '2026-09-07T06:00:00Z', repeat('a', 64), 'VERIFIED')
+                """, RUN_ID);
+        for (String table : new String[] {
+                "source_document", "news_article", "disclosure", "company_document",
+                "document_evidence", "company_relationship", "relationship_evidence",
+                "relationship_score_current", "relationship_score_history",
+                "company_metric_history", "graph_snapshot", "graph_snapshot_load"
+        }) {
+            jdbc.update("INSERT INTO cosmos_analysis." + table
+                    + " SELECT ?, p.* FROM public." + table + " p", RUN_ID);
+        }
+        jdbc.update("""
+                INSERT INTO cosmos_analysis.document_context
+                    (run_id, document_id, source_revision_id, sort_at, publication_precision)
+                SELECT ?, document_id, document_id::text,
+                       COALESCE(published_at, first_collected_at), 'UTC'
+                FROM public.source_document
+                """, RUN_ID);
+        jdbc.update("""
+                INSERT INTO cosmos_analysis.evidence_context
+                    (run_id, evidence_id, source_revision_id, source_kind, available_at, publication_precision)
+                SELECT ?, de.evidence_id, sd.document_id::text, sd.document_type, sd.published_at, 'UTC'
+                FROM public.document_evidence de
+                JOIN public.source_document sd ON sd.document_id = de.document_id
+                """, RUN_ID);
+        jdbc.update("""
+                INSERT INTO cosmos_analysis.active_run(singleton, run_id)
+                VALUES(TRUE, ?) ON CONFLICT(singleton) DO UPDATE SET run_id = EXCLUDED.run_id
+                """, RUN_ID);
+    }
+}
