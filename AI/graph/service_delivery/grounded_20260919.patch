+}
+
+/** A raw calendar date is not a verified instant: never convert it through Date. */
+export function fmtPublication(
+  document: { publishedAt?: string | null; publishedAtRaw?: string | null },
+  relative = false,
+) {
+  if (document.publishedAt && Number.isFinite(Date.parse(document.publishedAt))) {
+    return relative ? fmtRelative(document.publishedAt) : fmtDateTime(document.publishedAt);
+  }
+  const raw = document.publishedAtRaw?.trim();
+  const date = raw?.match(/^(\d{4})[-/.]?(\d{2})[-/.]?(\d{2})(?:\D|$)/);
+  return date ? `${date[1]}. ${date[2]}. ${date[3]}. (시각 미확인)` : "발행 시각 미확인";
+}
+
+/** Missing confidence is not zero; summarize only supplied numeric values. */
+export function meanConfidence(values: readonly (number | null | undefined)[]) {
+  const known = values.filter((value): value is number => value != null && Number.isFinite(value));
+  return known.length ? known.reduce((sum, value) => sum + value, 0) / known.length : null;
 }
 
