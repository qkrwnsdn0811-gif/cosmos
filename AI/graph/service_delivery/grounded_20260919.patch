new file mode 100644
--- /dev/null
+++ b/FrontEnd/scripts/test-analysis-contract.mjs
@@ -0,0 +1,79 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { test } from "node:test";
+import ts from "typescript";
+import { QueryClient } from "@tanstack/react-query";
+
+const require = createRequire(import.meta.url);
+function loadTypeScript(relative) {
+  const source = readFileSync(new URL(relative, import.meta.url), "utf8");
+  const { outputText } = ts.transpileModule(source, {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+  });
+  const module = { exports: {} };
+  new Function("module", "exports", "require", outputText)(module, module.exports, require);
+  return module.exports;
+}
+
+const { fmtPublication, meanConfidence } = loadTypeScript("../src/lib/format.ts");
+const { analyzeNewsImpact } = loadTypeScript("../src/lib/newsImpact.ts");
+const { resetAnalysisQueries } = loadTypeScript("../src/lib/analysisRun.ts");
+
+test("unknown publication time never becomes epoch or an invented hour", () => {
+  assert.equal(fmtPublication({ publishedAt: null }), "발행 시각 미확인");
+  assert.equal(fmtPublication({ publishedAt: null, publishedAtRaw: "2026-09-15 08:30" }), "2026. 09. 15. (시각 미확인)");
+  assert.equal(fmtPublication({ publishedAt: null, publishedAtRaw: "20260915" }, true), "2026. 09. 15. (시각 미확인)");
+  assert.equal(fmtPublication({ publishedAt: "invalid", publishedAtRaw: "unknown" }), "발행 시각 미확인");
+});
+
+test("confidence excludes absent values and preserves a genuine zero", () => {
+  assert.equal(meanConfidence([null, undefined]), null);
+  assert.equal(meanConfidence([0, null]), 0);
+  assert.equal(meanConfidence([0.8, null, 0.4]), 0.6000000000000001);
+});
+
+const graph = {
+  nodes: [{ companyId: "a", name: "A" }, { companyId: "b", name: "B" }],
+  edges: [{ relationshipId: "rel", sourceCompanyId: "a", targetCompanyId: "b", score: 90, relationshipType: "SUPPLY" }],
+};
+
+test("a selected company without an impact value stays pending and cannot seed indirect scores", () => {
+  const result = analyzeNewsImpact({ relatedCompanies: [{ companyId: "a", name: "A", relevanceScore: 0.9, impactScore: null }] }, graph);
+  assert.equal(result.hasScores, false);
+  assert.equal(result.ranking.length, 1);
+  assert.equal(result.ranking[0].score, null);
+  assert.equal(result.ranking[0].hop, 0);
+});
+
+test("unknown relevance also prevents inference, while measured zero remains zero", () => {
+  const pending = analyzeNewsImpact({ relatedCompanies: [{ companyId: "a", name: "A", relevanceScore: null, impactScore: 0.8 }] }, graph);
+  assert.equal(pending.ranking[0].score, null);
+  const zero = analyzeNewsImpact({ relatedCompanies: [{ companyId: "a", name: "A", relevanceScore: 0.9, impactScore: 0 }] }, graph);
+  assert.equal(zero.ranking[0].score, 0);
+  assert.equal(zero.ranking.length, 1);
+});
+
+test("version switch clears all analysis caches without resetting its own pointer or account state", async () => {
+  const client = new QueryClient({ defaultOptions: { queries: { gcTime: Infinity } } });
+  const roots = ["news", "graph", "relationship", "company", "companies", "industries"];
+  for (const root of roots) client.setQueryData([root, "cached"], { run: "old" });
+  client.setQueryData(["analysis-runs", "active"], { runId: "new" });
+  client.setQueryData(["me", "watchlist"], { items: ["keep"] });
+  await resetAnalysisQueries(client);
+  for (const root of roots) assert.equal(client.getQueryData([root, "cached"]), undefined);
+  assert.deepEqual(client.getQueryData(["analysis-runs", "active"]), { runId: "new" });
+  assert.deepEqual(client.getQueryData(["me", "watchlist"]), { items: ["keep"] });
+  client.clear();
+});
+
+test("a response started before version change cannot refill the cleared cache", async () => {
+  const client = new QueryClient({ defaultOptions: { queries: { gcTime: Infinity, retry: false } } });
+  let finish;
+  const inFlight = client.fetchQuery({ queryKey: ["news", "detail", "old"], queryFn: () => new Promise(resolve => { finish = resolve; }) }).catch(() => undefined);
+  await resetAnalysisQueries(client);
+  finish({ run: "old" });
+  await inFlight;
+  assert.equal(client.getQueryData(["news", "detail", "old"]), undefined);
+  client.clear();
+});
