# 이 파일을 복사해서 .env 로 만들고 값을 채운다 (.env 는 git에 올라가지 않는다).
#   cp .env.example .env
#
# JWT_SECRET 은 토큰 위조를 막는 서명 키다. 반드시 새로 만들어 쓰고, 팀 채널에 공유하지 않는다.
# 32바이트(영문 32자) 이상이어야 하며, 값이 없거나 짧으면 애플리케이션이 뜨지 않는다.
# 생성 예시 (Git Bash):
#   openssl rand -base64 48
JWT_SECRET=

# 아래는 로컬 docker-compose 기준 기본값이라 비워두면 그대로 동작한다.
# DB_URL=jdbc:postgresql://localhost:5432/cosmos
# DB_USERNAME=cosmos
# DB_PASSWORD=cosmos1234
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# 배포 환경에서만 바꾸는 값. 로컬은 기본값(false / Lax / 5173)이면 된다.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Lax
# CORS_ALLOWED_ORIGINS=http://localhost:5173
