# Replace with your application's name and the operator's actual contact email.
# example.com is deliberately rejected by the collector. Never commit real values.
SEC_EDGAR_USER_AGENT="COSMOS-Research/1.0 operator@example.com"
# Optional: used only by run_sec_edgar_resume_remote.sh when the variable above is unset.
# SEC_EDGAR_USER_AGENT_FILE=/private/path/sec-user-agent
# Optional HDFS helper configuration; paths depend on the target server.
# HDFS_BIN=/opt/hadoop/bin/hdfs
# HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
# JAVA_HOME=/path/to/your/jdk
