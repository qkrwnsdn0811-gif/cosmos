# Copy outside Git to /etc/cosmos/sec.env and adjust these server-specific paths.
SEC_STATE_DIR=/home/ubuntu/sec-edgar-incremental/state
SEC_UNIVERSE=/home/ubuntu/sec-edgar-incremental/config/companies.json
# Plaintext private file containing the existing operator-provided SEC User-Agent.
# No example contact is sent to SEC; this file must be supplied before starting.
SEC_EDGAR_USER_AGENT_FILE=/etc/cosmos/sec-user-agent
SEC_START_DATE=2026-09-09
SEC_MAX_FILINGS=200
SEC_REQUEST_DELAY=0.2
SEC_HDFS_ROOT=/data-lake/raw/realtime/sec-edgar
HDFS_BIN=/opt/hadoop/bin/hdfs
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
HADOOP_USER_NAME=ubuntu
