# Non-secret example for the existing Hadoop Master. Do not commit real credentials.
NEWS_APP_ROOT=/home/ubuntu/news-kafka/app
NEWS_PYTHON=/home/ubuntu/news-kafka/venv/bin/python
NEWS_NODE=/home/ubuntu/news-kafka/runtime/node-v22.23.2-linux-x64/bin/node
NEWS_STATE_DIR=/home/ubuntu/news-kafka/state
NEWS_WRITER_STATE_DIR=/home/ubuntu/news-kafka/writer-state
NEWS_JOBS=latest,domestic,backfill
NEWS_LIMIT=8
KAFKA_BOOTSTRAP_SERVERS=100.117.115.44:9092
NEWS_TOPIC=news.raw
NEWS_GROUP=cosmos-news-hdfs-v1
NEWS_HDFS_ROOT=/data-lake/raw/realtime/news
# URL seeder only; the Writer reads fs.defaultFS from HADOOP_CONF_DIR instead.
HDFS_HOST=100.117.115.44
HDFS_PORT=9000
HADOOP_USER_NAME=ubuntu
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
