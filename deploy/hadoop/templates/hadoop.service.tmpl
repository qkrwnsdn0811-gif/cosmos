[Unit]
Description=COSMOS Hadoop ${daemon}
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service
RequiresMountsFor=/data
${condition}

[Service]
Type=simple
User=${user}
Group=${user}
Environment="JAVA_HOME=${java_home}"
Environment="HADOOP_HOME=/opt/hadoop"
Environment="HADOOP_CONF_DIR=${hadoop_conf}"
Environment="HADOOP_LOG_DIR=/var/log/cosmos-hadoop"
Environment="HADOOP_PID_DIR=/run/cosmos-hadoop"
RuntimeDirectory=cosmos-hadoop
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
WorkingDirectory=/opt/hadoop
ExecStart=/opt/hadoop/bin/${binary} ${daemon}
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGTERM
KillMode=control-group
LimitNOFILE=65536
UMask=0027

[Install]
WantedBy=multi-user.target
