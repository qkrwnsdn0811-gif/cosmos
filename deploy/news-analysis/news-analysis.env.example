# Install as /etc/cosmos/news-analysis.env with mode 0640.
NEWS_ANALYSIS_PROJECT_DIR=/opt/cosmos/news-analysis/current/AI/ner
NEWS_ANALYSIS_PYTHON=/opt/cosmos/news-analysis/venv/bin/python

NEWS_ANALYSIS_RAW_GLOB=hdfs://100.117.115.44:9000/data-lake/raw/realtime/news/topic=news.raw/partition=*/start=*/_manifest.json
NEWS_ANALYSIS_OUTPUT_BASE=hdfs://100.117.115.44:9000/data-lake/analyzed/news/company-mentions
NEWS_ANALYSIS_ALIASES=/opt/cosmos/news-analysis/current/AI/ner/data/aliases.csv
NEWS_ANALYSIS_COMPANIES=/opt/cosmos/news-analysis/current/AI/ner/data/companies.csv
NEWS_ANALYSIS_MODEL_VERSION=dict-v1.3
# Required: immutable release/git identifier for the deployed AI/ner code.
NEWS_ANALYSIS_VERSION=replace-with-release-revision
NEWS_ANALYSIS_MAX_BATCHES=50
NEWS_ANALYSIS_STATE_FILE=/var/lib/cosmos-news-analysis/runner-state.json
NEWS_ANALYSIS_LOCK_FILE=/run/cosmos-news-analysis/runner.lock

HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
HDFS_BIN=/opt/hadoop/bin/hdfs
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ARROW_LIBHDFS_DIR=/opt/hadoop/lib/native
LD_LIBRARY_PATH=/opt/hadoop/lib/native
