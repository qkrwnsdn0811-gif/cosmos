[Unit]
Description=COSMOS evidence sentences and company sentiment for matched news
After=network-online.target cosmos-hadoop-namenode.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/cosmos/news-enrich.env
WorkingDirectory=/opt/cosmos/news-enrich/current/AI/gpu_news
ExecStart=/usr/bin/bash /opt/cosmos/news-enrich/current/deploy/news-enrich/run-news-enrich.sh
StateDirectory=cosmos-news-enrich
StateDirectoryMode=0750
RuntimeDirectory=cosmos-news-enrich
RuntimeDirectoryMode=0750
UMask=0027
# A pass is seconds of work at live volume. This bound is for a stuck HDFS call,
# and it stays under the ten-minute period so passes cannot pile up.
# Twenty batches of CPU FinBERT on this box is 5.5 to 9 minutes of CPU time -
# measured 2026-09-23 over seven timer runs. Eight minutes sat inside that
# range, so five of the seven were SIGTERMed mid-batch; the pass that fit
# finished, the pass that did not was killed, and which one you got was the
# size of the articles. A timeout is a hang detector and has to sit well
# above a normal pass, not on top of it. Published batches survive a kill
# (staging then rename), so the cost was the in-flight batch plus ten minutes.
TimeoutStartSec=25min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cosmos-news-enrich /run/cosmos-news-enrich
RestrictSUIDSGID=true
LockPersonality=true
