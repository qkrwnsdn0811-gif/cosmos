[Unit]
Description=COSMOS add news-derived relations to the published graph
After=network-online.target cosmos-news-enrich.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/cosmos/relation-loader.env
WorkingDirectory=/opt/cosmos/news-enrich/current/Crawling/documents
ExecStart=/usr/bin/bash /opt/cosmos/news-enrich/current/deploy/news-enrich/run-relation-loader.sh
StateDirectory=cosmos-relation-loader
StateDirectoryMode=0750
UMask=0027
# Twice a day, and the first pass walks the whole enriched tree: 12,160 batches
# at a few tenths of a second each is over an hour. State is written after every
# batch, so a pass cut short resumes where it stopped - but a limit that always
# cuts the first fill is a limit that only ever measures itself. Ninety minutes
# sits above a full walk; a genuinely hung pass takes that long to show.
# 4h, not 90min: the first full walk measured 0.25s a batch on an idle box and
# 0.6-0.8s with two `hdfs dfs` JVMs from the enrich tick competing for the two
# cores (2026-09-23 07:28, load 7.9). 12,268 batches at that pace is over two
# hours, and a limit that kills a legitimate full pass only costs a restart -
# state is per batch - but it costs one every time. Nothing this unit does
# hangs silently; a stuck pass shows up as a flat batch count in the journal.
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cosmos-relation-loader
RestrictSUIDSGID=true
LockPersonality=true
