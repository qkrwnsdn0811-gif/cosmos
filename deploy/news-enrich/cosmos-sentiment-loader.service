[Unit]
Description=COSMOS load company sentiment and evidence into Postgres
After=network-online.target cosmos-news-enrich.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/cosmos/sentiment-loader.env
WorkingDirectory=/opt/cosmos/news-enrich/current/Crawling/documents
ExecStart=/usr/bin/bash /opt/cosmos/news-enrich/current/deploy/news-enrich/run-sentiment-loader.sh
StateDirectory=cosmos-sentiment-loader
StateDirectoryMode=0750
UMask=0027
# A pass loads every batch that is pending, so its length is set by the
# backlog, not by the steady state. Eight minutes fitted the ten or twenty
# batches a timer tick leaves behind and killed every pass once a GPU backfill
# put thousands there: 2026-09-23, six consecutive runs SIGTERMed mid-batch,
# the unit left `failed`, throughput pinned at what fits in eight minutes.
# State is written after each batch, so a killed pass kept its work and the
# backlog drained at the rate of the axe rather than the machine. The cost of
# the longer limit is that a genuinely hung pass takes this long to show up.
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cosmos-sentiment-loader
RestrictSUIDSGID=true
LockPersonality=true
