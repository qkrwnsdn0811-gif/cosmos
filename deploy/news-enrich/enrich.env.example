# Copy to /etc/cosmos/news-enrich.env
NEWS_ENRICH_PROJECT_DIR=/opt/cosmos/news-enrich/current
NEWS_ENRICH_PYTHON=/opt/cosmos/news-enrich/venv/bin/python
NEWS_ENRICH_CONFIG=/etc/cosmos/news-enrich.json
NEWS_ENRICH_BUNDLE=/opt/cosmos/news-enrich/models/finbert-v1
# cpu is the supported value here. The live pass is a few seconds of work and
# the server has no GPU; cuda belongs to the one-off backfill on a workstation.
NEWS_ENRICH_DEVICE=cpu
NEWS_ENRICH_BATCH_SIZE=32
NEWS_ENRICH_MAX_BATCHES=150
HADOOP_HOME=/opt/hadoop
