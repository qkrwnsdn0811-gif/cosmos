[Unit]
Description=COSMOS relationship snapshot %i from HDFS to PostgreSQL
Wants=network-online.target
After=network-online.target cosmos-hadoop-namenode.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/cosmos/app
EnvironmentFile=/etc/cosmos/rdb-loader.env
ExecStart=/usr/bin/bash /opt/cosmos/app/deploy/rdb-loader/run-loader.sh --input ${RDB_LOADER_INPUT_ROOT}/%i
TimeoutStartSec=2h
TimeoutStopSec=120
KillMode=control-group
UMask=0077
Nice=5
MemoryHigh=1536M
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
