# Install as /etc/cosmos/rdb-loader.env, root:ubuntu 0640. Keep real values out of Git.
# Use the same absolute release path as cosmos-rdb-loader@.service.
RDB_LOADER_APP_ROOT=/opt/cosmos/app
PYTHON_BIN=/opt/cosmos/app/.venv-rdb-loader/bin/python
SPARK_BIN=/opt/spark/bin/spark-submit
HDFS_BIN=/opt/hadoop/bin/hdfs
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# The service instance name is appended to this immutable snapshot root.
RDB_LOADER_INPUT_ROOT=hdfs://cosmos-master:9000/data-lake/processed/relationship-scores

# Choose a PostgreSQL endpoint reachable from the Hadoop Master.
# The application Docker Compose does not expose a host PostgreSQL port by default.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cosmos
PGUSER=cosmos_loader
PGPASSFILE=/etc/cosmos/rdb-loader.pgpass
PGCONNECT_TIMEOUT=10
PGAPPNAME=cosmos-rdb-loader

# Alternatively set DATABASE_URL in the protected environment file.
# Never place credentials in command-line arguments or the snapshot manifest.
