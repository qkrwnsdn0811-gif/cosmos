# Install outside Git as /etc/cosmos/stock-prices.env, mode 0600.
# This example deliberately performs local collection + validation only.
STOCK_PRICE_PROJECT_DIR=/opt/cosmos/stock-prices/current/Crawling/prices
STOCK_PRICE_PYTHON=/opt/cosmos/stock-prices/venv/bin/python
STOCK_PRICE_STATE_DIR=/var/lib/cosmos/stock-prices/state
STOCK_PRICE_OUTPUT_DIR=/var/lib/cosmos/stock-prices/runs
STOCK_PRICE_REQUEST_INTERVAL=1
STOCK_PRICE_ATTEMPTS=2
STOCK_PRICE_HDFS_ROOT=/data-lake/raw/stock-prices/daily
STOCK_PRICE_PUBLISH=0
HDFS_BIN=/opt/hadoop/bin/hdfs
# Set the actual Hadoop authority before STOCK_PRICE_PUBLISH=1.
# HDFS_URI=hdfs://namenode.example.internal:9000
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
# JAVA_HOME=/path/to/the/installed/hadoop-compatible-jdk

# PostgreSQL is an independent, opt-in step after successful HDFS publication.
# It requires existing company mappings and the matching database schema.
STOCK_PRICE_PG_LOAD=0
# STOCK_DATABASE_URL=... supply securely outside Git; never echo this value
